generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id                  String                  @id @default(uuid())
  username            String                  @unique
  password            String
  name                String
  avatar              String?
  roleId              String
  regionId            String?
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  createdDevices      CustomerDevice[]
  feeRecords          FeeRecord[]
  notifications       Notification[]
  createdProjects     PerformanceProject[]
  createdRecords      PerformanceRecord[]
  projectMemberships  ProjectMember[]
  region              Region?                 @relation(fields: [regionId], references: [id])
  role                Role                    @relation(fields: [roleId], references: [id])
  wikiArticles        WikiArticle[]
  wikiArticleLikes    WikiArticleLike[]
  completedWorkOrders WorkOrder[]             @relation("CompleterWorkOrders")
  createdWorkOrders   WorkOrder[]             @relation("CreatorWorkOrders")
  receivedWorkOrders  WorkOrder[]             @relation("ReceiverWorkOrders")
  collaborations      WorkOrderCollaborator[]

  @@index([roleId])
  @@index([regionId])
}

model Customer {
  id                 String              @id @default(uuid())
  name               String
  shortName          String?
  namePinyin         String?
  nameInitials       String?
  contact            String?
  phone              String?
  address            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  devices            CustomerDevice[]
  performanceRecords PerformanceRecord[]
  workOrders         WorkOrder[]
  feeRecords         FeeRecord[]

  @@index([shortName])
}

model Region {
  id              String      @id @default(uuid())
  name            String      @unique
  namePinyin      String?
  nameInitials    String?
  sortOrder       Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  dingtalkSecret  String?
  dingtalkWebhook String?
  users           User[]
  workOrders      WorkOrder[]
}

model ServiceType {
  id           String      @id @default(uuid())
  name         String      @unique
  namePinyin   String?
  nameInitials String?
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workOrders   WorkOrder[]
}

model WorkOrder {
  id            String                  @id @default(uuid())
  detail        String
  status        WorkOrderStatus         @default(PENDING)
  scoreLevel    ScoreLevel              @default(NORMAL)
  customerId    String
  regionId      String
  serviceTypeId String
  creatorId     String
  createdAt     DateTime                @default(now())
  receiverId    String?
  receivedAt    DateTime?
  completerId   String?
  completedAt   DateTime?
  updatedAt     DateTime                @updatedAt
  repairFee     Float?
  completer     User?                   @relation("CompleterWorkOrders", fields: [completerId], references: [id])
  creator       User                    @relation("CreatorWorkOrders", fields: [creatorId], references: [id])
  customer      Customer                @relation(fields: [customerId], references: [id])
  receiver      User?                   @relation("ReceiverWorkOrders", fields: [receiverId], references: [id])
  region        Region                  @relation(fields: [regionId], references: [id])
  serviceType   ServiceType             @relation(fields: [serviceTypeId], references: [id])
  collaborators WorkOrderCollaborator[]

  @@index([status])
  @@index([regionId])
  @@index([createdAt])
  @@index([creatorId])
  @@index([receiverId])
  @@index([customerId])
}

model WorkOrderCollaborator {
  id          String    @id @default(uuid())
  workOrderId String
  userId      String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, userId])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String
  title       String
  content     String
  workOrderId String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model WikiCategory {
  id        String         @id @default(uuid())
  name      String         @unique
  sortOrder Int            @default(0)
  parentId  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  articles  WikiArticle[]
  parent    WikiCategory?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  WikiCategory[] @relation("CategoryToCategory")
}

model WikiTag {
  id        String        @id @default(uuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  articles  WikiArticle[] @relation("ArticleToTag")
}

model WikiArticle {
  id            String            @id @default(uuid())
  title         String
  content       String
  viewCount     Int               @default(0)
  isPublic      Boolean           @default(true)
  categoryId    String
  authorId      String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  chunks        Json?             @default("[]")
  contentVector String?
  likeCount     Int               @default(0)
  titlePinyin   String?
  titleInitials String?
  author        User              @relation(fields: [authorId], references: [id])
  category      WikiCategory      @relation(fields: [categoryId], references: [id])
  likes         WikiArticleLike[]
  attachments   WikiAttachment[]
  tags          WikiTag[]         @relation("ArticleToTag")
}

model WikiAttachment {
  id        String      @id @default(uuid())
  filename  String
  url       String
  size      Int
  mimeType  String
  articleId String
  createdAt DateTime    @default(now())
  article   WikiArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model WikiArticleLike {
  id        String      @id @default(uuid())
  userId    String
  articleId String
  createdAt DateTime    @default(now())
  article   WikiArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])

  @@unique([userId, articleId])
}

model FeeSetting {
  id          String   @id @default(uuid())
  category    String
  item        String
  unit        String
  price       Float
  description String?
  threshold   Int?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([category, item])
  @@index([category])
}

model PerformanceProject {
  id                String              @id @default(uuid())
  projectName       String
  calculationType   CalculationType
  totalQuantity     Int?
  remark            String?
  createdAt         DateTime            @default(now())
  creatorId         String
  deliveryUnitPrice Float               @default(0)
  installUnitPrice  Float               @default(0)
  debugUnitPrice    Float               @default(0)
  dailyPrice        Float               @default(0)
  deviceList        CustomerDevice[]
  creator           User                @relation(fields: [creatorId], references: [id])
  records           PerformanceRecord[]
  members           ProjectMember[]
  feeRecords        FeeRecord[]

  @@index([creatorId])
}

model ProjectMember {
  id        String             @id @default(uuid())
  projectId String
  userId    String
  role      ProjectMemberRole  @default(MEMBER)
  joinedAt  DateTime           @default(now())
  project   PerformanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model PerformanceRecord {
  id              String             @id @default(uuid())
  projectId       String
  recordType      RecordType?
  quantity        Int?
  customerId      String?
  workHours       Float?
  description     String?
  date            String
  collaboratorIds String[]
  includeRecorder Boolean            @default(true)
  remark          String?
  createdAt       DateTime           @default(now())
  creatorId       String
  deviceId        String?
  creator         User               @relation(fields: [creatorId], references: [id])
  customer        Customer?          @relation(fields: [customerId], references: [id])
  device          CustomerDevice?    @relation(fields: [deviceId], references: [id])
  project         PerformanceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([creatorId])
}

model CustomerDevice {
  id                    String              @id @default(uuid())
  projectId             String
  customerId            String
  deviceName            String
  expectedQuantity      Int                 @default(0)
  deliveryQuantity      Int                 @default(0)
  deliveryBy            String?
  deliveryAt            DateTime?
  deliveryCollaborators String[]
  installQuantity       Int                 @default(0)
  installBy             String?
  installAt             DateTime?
  installCollaborators  String[]
  debugQuantity         Int                 @default(0)
  debugBy               String?
  debugAt               DateTime?
  debugCollaborators    String[]
  isCompleted           Boolean             @default(false)
  completedAt           DateTime?
  remark                String?
  createdAt             DateTime            @default(now())
  creatorId             String
  creator               User                @relation(fields: [creatorId], references: [id])
  customer              Customer            @relation(fields: [customerId], references: [id])
  project               PerformanceProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  records               PerformanceRecord[]

  @@index([projectId])
  @@index([customerId])
  @@index([creatorId])
}

model FeeRecord {
  id              String              @id @default(uuid())
  projectId       String?
  customerId      String?
  items           Json
  subtotal        Float
  discount        Float               @default(0)
  actualAmount    Float
  remark          String?
  collaboratorIds String[]            @default([])
  createdAt       DateTime            @default(now())
  creatorId       String?
  creator         User?               @relation(fields: [creatorId], references: [id])
  project         PerformanceProject? @relation(fields: [projectId], references: [id])
  customer        Customer?           @relation(fields: [customerId], references: [id])

  @@index([createdAt])
  @@index([creatorId])
  @@index([projectId])
  @@index([customerId])
}

enum WorkOrderStatus {
  PENDING
  RECEIVED
  COMPLETED
}

enum ScoreLevel {
  SIMPLE
  NORMAL
  COMPLEX
}

enum CalculationType {
  QUANTITY
  DAILY
  WAREHOUSE
}

enum RecordType {
  DELIVERY
  INSTALL
  DEBUG
  CONSTRUCTION
}

enum ProjectMemberRole {
  OWNER
  MEMBER
}
