# 数据库连接 (示例配置，实际部署时修改)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kworkorder?schema=public"

# JWT 配置 (生产环境请更改密钥)
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# 服务端口
PORT=3000

# 运行环境
NODE_ENV="development"

# 默认密码 - 用于检测用户是否使用默认密码
DEFAULT_PASSWORD="changeme123"
