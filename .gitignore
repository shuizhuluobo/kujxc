# Root level ignores
/*
!/.gitignore
!/backend/
!/frontend/
!/shared/
!/README.md
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml

# Local sensitive scripts and data (ALWAYS IGNORED)
/local_scripts/
/manuals_data/
/build-output/
/temp/
/tmp/

# Backend specific
backend/node_modules/
backend/dist/
backend/coverage/
backend/prisma/migrations/
backend/uploads/
backend/*.log
backend/.env*
!backend/.env.example

# Frontend specific
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/android/.gradle/
frontend/android/app/build/
frontend/android/local.properties
frontend/*.log
frontend/.env*
!frontend/.env.example

# OS & IDE
.DS_Store
.idea/
.vscode/

# Common patterns
*.log
*.zip
*.tar.gz
*.sql
*.jks
*.key
*.pem
*.crt
